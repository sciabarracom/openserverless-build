# github user, used to derive the default local image names
GITHUB_USER=github: put here your github user

# for the github registry (ghcr.io)
GH_USER=<github user>
GH_TOKEN=<github token>

# for dockerhub
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# This component builds MULTIPLE images (see BUILD.md, case B).
# Each variable holds the image NAME ONLY (no registry, no tag): the registry
# comes from DOCKER_REGISTRY and the tag from "task tag".
MY_CONTROLLER_IMAGE=openserverless-wsk-controller
MY_INVOKER_IMAGE=openserverless-wsk-invoker
MY_SCHEDULER_IMAGE=openserverless-wsk-scheduler
MY_STANDALONE_IMAGE=openserverless-wsk-standalone

# where the images are pushed - defaults to docker.io/apache
# for your own builds use e.g. ghcr.io/<your-user>
#DOCKER_REGISTRY=ghcr.io/<your-user>
